		{
			"name": "pagination",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"// Folder-level test script for list endpoints: assert the shared PokeAPI list",
							"// envelope once so each request in this folder only asserts what is unique to it.",
							"// Source: PokeAPI list envelope { count, next, previous, results:[{name, url}] }.",
							"const envelope = pm.response.json();",
							"",
							"pm.test('status code is 200', function () {",
							"    pm.expect(pm.response.code).to.eql(200);",
							"});",
							"",
							"pm.test('count is an integer', function () {",
							"    pm.expect(envelope.count).to.be.a('number');",
							"    pm.expect(Number.isInteger(envelope.count)).to.be.true;",
							"});",
							"",
							"pm.test('body has next and previous properties', function () {",
							"    pm.expect(envelope).to.have.property('next');",
							"    pm.expect(envelope).to.have.property('previous');",
							"});",
							"",
							"pm.test('results is an array', function () {",
							"    pm.expect(envelope.results).to.be.an('array');",
							"});",
							"",
							"pm.test('each result is a valid named reference', function () {",
							"    envelope.results.forEach(function (result) {",
							"        pm.expect(result.name).to.be.a('string');",
							"        pm.expect(result.name.length).to.be.above(0);",
							"        pm.expect(result.url).to.be.a('string');",
							"        pm.expect(result.url).to.match(/^https?:\\/\\//);",
							"        pm.expect(result.url).to.include('/api/v2/');",
							"    });",
							"});"
						]
					}
				}
			],
			"item": [
				{
					"name": "List first 5 Pokémon",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// The shared list envelope (status 200, count/next/previous/results, named refs)",
									"// is asserted once in the pagination folder-level test script. This request",
									"// only asserts what is unique to the first page.",
									"const jsonData = pm.response.json();",
									"",
									"pm.test('results array has length 5', function () {",
									"    pm.expect(jsonData.results).to.be.an('array');",
									"    pm.expect(jsonData.results).to.have.lengthOf(5);",
									"});",
									"",
									"// Share this page's count so 'List page 2' can assert the count is stable.",
									"pm.collectionVariables.set('firstPageCount', jsonData.count);"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v2/pokemon/?limit=5&offset=0",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v2",
								"pokemon",
								""
							],
							"query": [
								{
									"key": "limit",
									"value": "5"
								},
								{
									"key": "offset",
									"value": "0"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "List page 2 honours offset and next/previous contract",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// The shared list envelope is asserted once in the pagination folder-level",
									"// test script. This request asserts only the offset/link contract for page 2.",
									"// Source: PokeAPI list paging - previous/next are full URLs carrying offset/limit.",
									"const jsonData = pm.response.json();",
									"",
									"pm.test('results array has length 5', function () {",
									"    pm.expect(jsonData.results).to.be.an('array');",
									"    pm.expect(jsonData.results).to.have.lengthOf(5);",
									"});",
									"",
									"pm.test('previous link points back to offset=0', function () {",
									"    pm.expect(jsonData.previous).to.be.a('string');",
									"    pm.expect(jsonData.previous).to.include('offset=0');",
									"    pm.expect(jsonData.previous).to.include('limit=5');",
									"});",
									"",
									"pm.test('next link points to offset=10', function () {",
									"    pm.expect(jsonData.next).to.be.a('string');",
									"    pm.expect(jsonData.next).to.include('offset=10');",
									"    pm.expect(jsonData.next).to.include('limit=5');",
									"});",
									"",
									"pm.test('count matches the first-page count', function () {",
									"    const firstPageCount = Number(pm.collectionVariables.get('firstPageCount'));",
									"    pm.expect(Number.isInteger(firstPageCount)).to.be.true;",
									"    pm.expect(jsonData.count).to.eql(firstPageCount);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v2/pokemon/?limit=5&offset=5",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v2",
								"pokemon",
								""
							],
							"query": [
								{
									"key": "limit",
									"value": "5"
								},
								{
									"key": "offset",
									"value": "5"
								}
							]
						}
					},
					"response": []
				}
			]
		},
