									"// request lives in its own folder so the pagination folder-level named-ref",
									"// script does not run against results that intentionally have no name.",
									"// Source: PokeAPI APIResourceList { count, next, previous, results:[{url}] }.",
									"const jsonData = pm.response.json();",
									"",
									"pm.test('status code is 200', function () {",
									"    pm.expect(pm.response.code).to.eql(200);",
									"});",
									"",
									"pm.test('count is an integer', function () {",
									"    pm.expect(jsonData.count).to.be.a('number');",
									"    pm.expect(Number.isInteger(jsonData.count)).to.be.true;",
