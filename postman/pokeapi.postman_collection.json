								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v2/evolution-chain/?limit=3&offset=0",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v2",
								"evolution-chain",
								""
							],
							"query": [
								{
									"key": "limit",
									"value": "3"
								},
								{
									"key": "offset",
									"value": "0"
								}
							]
