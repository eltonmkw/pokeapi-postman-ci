{
	"info": {
		"name": "PokéAPI CI",
		"description": "Minimal API test suite for the public PokéAPI (https://pokeapi.co). Requests are grouped into v2.1 folders (pokemon, types, pagination, errors) and validate a known Pokémon, a Type resource and its documented damage relations, paginated lists, and 404s for nonexistent resources. The pagination folder asserts the shared list envelope once in a folder-level test script. The base URL is a collection variable so it can be changed in one place.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "https://pokeapi.co",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "pokemon",
			"item": [
				{
					"name": "Get Pikachu",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status code is 200', function () {",
									"    pm.expect(pm.response.code).to.eql(200);",
									"});",
									"",
									"const jsonData = pm.response.json();",
									"",
									"pm.test('id is 25', function () {",
									"    pm.expect(jsonData.id).to.eql(25);",
									"});",
									"",
									"pm.test(\"name is 'pikachu'\", function () {",
									"    pm.expect(jsonData.name).to.eql('pikachu');",
									"});",
									"",
									"pm.test(\"types include 'electric'\", function () {",
									"    const hasElectric = jsonData.types.some(function (t) {",
									"        return t.type.name === 'electric';",
									"    });",
									"    pm.expect(hasElectric).to.be.true;",
									"});",
									"",
									"// Scenario C: documented Pokemon schema field types.",
									"// Source: official PokeAPI Pokemon type table",
									"// (id:int, name:string, base_experience:int, height:int, is_default:bool, weight:int, types:list).",
									"pm.test('field types: id is an integer', function () {",
									"    pm.expect(jsonData.id).to.be.a('number');",
									"    pm.expect(Number.isInteger(jsonData.id)).to.be.true;",
									"});",
									"",
									"pm.test('field types: name is a string', function () {",
									"    pm.expect(jsonData.name).to.be.a('string');",
									"});",
									"",
									"pm.test('field types: base_experience is an integer', function () {",
									"    pm.expect(jsonData.base_experience).to.be.a('number');",
									"    pm.expect(Number.isInteger(jsonData.base_experience)).to.be.true;",
									"});",
									"",
									"pm.test('field types: height is an integer', function () {",
									"    pm.expect(jsonData.height).to.be.a('number');",
									"    pm.expect(Number.isInteger(jsonData.height)).to.be.true;",
									"});",
									"",
									"pm.test('field types: weight is an integer', function () {",
									"    pm.expect(jsonData.weight).to.be.a('number');",
									"    pm.expect(Number.isInteger(jsonData.weight)).to.be.true;",
									"});",
									"",
									"pm.test('field types: is_default is a boolean', function () {",
									"    pm.expect(jsonData.is_default).to.be.a('boolean');",
									"});",
									"",
									"pm.test('field types: types is an array', function () {",
									"    pm.expect(jsonData.types).to.be.an('array');",
									"});",
									"",
									"// Scenario E: the types list is a well-formed PokemonType list.",
									"// Source: PokemonType (slot:integer, type: NamedAPIResource {name, url}).",
									"pm.test('types list: is a non-empty array', function () {",
									"    pm.expect(jsonData.types).to.be.an('array');",
									"    pm.expect(jsonData.types.length).to.be.above(0);",
									"});",
									"",
									"pm.test('types list: every entry has an integer slot >= 1', function () {",
									"    jsonData.types.forEach(function (entry) {",
									"        pm.expect(entry.slot).to.be.a('number');",
									"        pm.expect(Number.isInteger(entry.slot)).to.be.true;",
									"        pm.expect(entry.slot).to.be.at.least(1);",
									"    });",
									"});",
									"",
									"pm.test('types list: slots are 1-based contiguous and unique', function () {",
									"    const slots = jsonData.types.map(function (entry) {",
									"        return entry.slot;",
									"    }).sort(function (a, b) {",
									"        return a - b;",
									"    });",
									"    const expected = jsonData.types.map(function (_, index) {",
									"        return index + 1;",
									"    });",
									"    pm.expect(slots).to.eql(expected);",
									"});",
									"",
									"pm.test('types list: each entry type is a valid named reference', function () {",
									"    jsonData.types.forEach(function (entry) {",
									"        pm.expect(entry.type.name).to.be.a('string');",
									"        pm.expect(entry.type.name.length).to.be.above(0);",
									"        pm.expect(entry.type.url).to.be.a('string');",
									"        pm.expect(entry.type.url).to.include('/api/v2/type/');",
									"    });",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v2/pokemon/pikachu/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v2",
								"pokemon",
								"pikachu",
								""
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "types",
			"item": [
				{
					"name": "Get type: ground - damage relations resolve as documented",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status code is 200', function () {",
									"    pm.expect(pm.response.code).to.eql(200);",
									"});",
									"",
									"const jsonData = pm.response.json();",
									"",
									"// Scenario: Type resource core fields.",
									"// Source: official PokeAPI Type (id:int, name:string, damage_relations: TypeRelations).",
									"pm.test('id is an integer', function () {",
									"    pm.expect(jsonData.id).to.be.a('number');",
									"    pm.expect(Number.isInteger(jsonData.id)).to.be.true;",
									"});",
									"",
									"pm.test(\"name is 'ground'\", function () {",
									"    pm.expect(jsonData.name).to.eql('ground');",
									"});",
									"",
									"// TypeRelations has six lists, each a list of NamedAPIResource {name, url}.",
									"const relationKeys = [",
									"    'no_damage_to',",
									"    'half_damage_to',",
									"    'double_damage_to',",
									"    'no_damage_from',",
									"    'half_damage_from',",
									"    'double_damage_from'",
									"];",
									"",
									"pm.test('damage_relations has the six list keys', function () {",
									"    pm.expect(jsonData.damage_relations).to.be.an('object');",
									"    relationKeys.forEach(function (key) {",
									"        pm.expect(jsonData.damage_relations).to.have.property(key);",
									"        pm.expect(jsonData.damage_relations[key]).to.be.an('array');",
									"    });",
									"});",
									"",
									"pm.test('each damage relation entry is a valid named reference', function () {",
									"    relationKeys.forEach(function (key) {",
									"        jsonData.damage_relations[key].forEach(function (ref) {",
									"            pm.expect(ref.name).to.be.a('string');",
									"            pm.expect(ref.name.length).to.be.above(0);",
									"            pm.expect(ref.url).to.be.a('string');",
									"            pm.expect(ref.url).to.match(/^https?:\\/\\//);",
									"            pm.expect(ref.url).to.include('/api/v2/type/');",
									"        });",
									"    });",
									"});",
									"",
									"// Documented stable relations for ground.",
									"// Source: PokeAPI TypeRelations for type/ground (id 5).",
									"function relationNames(key) {",
									"    return jsonData.damage_relations[key].map(function (ref) {",
									"        return ref.name;",
									"    });",
									"}",
									"",
									"pm.test(\"double_damage_to includes 'poison'\", function () {",
									"    pm.expect(relationNames('double_damage_to')).to.include('poison');",
									"});",
									"",
									"pm.test(\"no_damage_to includes 'flying'\", function () {",
									"    pm.expect(relationNames('no_damage_to')).to.include('flying');",
									"});",
									"",
									"pm.test(\"no_damage_from includes 'electric'\", function () {",
									"    pm.expect(relationNames('no_damage_from')).to.include('electric');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v2/type/ground/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v2",
								"type",
								"ground",
								""
							]
						}
					},
					"response": []
				},
				{
					"name": "Type lookup by id equals lookup by name",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('status code is 200', function () {",
									"    pm.expect(pm.response.code).to.eql(200);",
									"});",
									"",
									"const jsonData = pm.response.json();",
									"",
									"// Scenario: lookup by id returns the same resource as lookup by name.",
									"// Source: PokeAPI {id or name} consistency invariant for type/5 == type/ground.",
									"pm.test('id is 5', function () {",
									"    pm.expect(jsonData.id).to.eql(5);",
									"});",
									"",
									"pm.test(\"name is 'ground'\", function () {",
									"    pm.expect(jsonData.name).to.eql('ground');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/v2/type/5/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v2",
								"type",
								"5",
								""
							]
						}
					},
					"response": []
				}
			]
		},
